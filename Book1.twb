      <aliases enabled='yes' />
      <column caption='Disconted margin' datatype='real' name='[Calculation_0399728480485377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0399728488726530]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Discount Impact' datatype='string' name='[Calculation_0399728489717763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] &gt;= 0.30 THEN &quot;High Discount&quot;&#13;&#10;ELSEIF [Discount] &gt;= 0.10 THEN &quot;Medium Discount&quot;&#13;&#10;ELSE &quot;Low/No Discount&quot;&#13;&#10;END' />
      </column>
      <column caption='Shipping Performance' datatype='integer' name='[Calculation_0399728492527620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Ship Date])' />
      </column>
      <column caption=' High-Discount Losses' datatype='real' name='[Calculation_0399728493760517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Discount] &gt;= 0.30 THEN [Profit] ELSE 0 END)' />
      </column>
      <column caption='Bulk Orders' datatype='string' name='[Calculation_0399728496566278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quantity] &gt;= 5 THEN &quot;Bulk&quot; ELSE &quot;Regular&quot; END' />
      </column>
      <column caption='Net Sales After Discount' datatype='real' name='[Calculation_0399728497397767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]-[Sales]*[Discount]' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
